classDiagram
    direction LR
    class Evenement{
        -int id_evenement
        -varchar nom_evenement
        -varchar type_evenement
        -text description_evenement
        -date date_debut
        -date date_fin
        -varchar lieu
        -varchar ville
        -varchar status
    }
    class Stand{
        -int id_stand
        -int stand_numero
        -text superficie
        -int prix
        -varchar statut
    }
    class Exposant{
        -int id_exposant
        -varchar raison_sociale
        -varchar email
        -int telephone
        -varchar site_web
    }
    class Secteur_activité{
        -int id_secteur
        -varchar nom
        -varchar description
    }
    Evenement -- Stand : contient
    Stand -- Exposant: réserver
    Exposant -- Secteur_activité : appartient